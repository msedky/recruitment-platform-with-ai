# 1. Create namespace first
kubectl apply -f k8s/namespace.yaml

# 2. Create secrets and configmap
kubectl apply -f k8s/secrets.yaml
kubectl apply -f k8s/configmap.yaml

# 3. Deploy PostgreSQL
kubectl apply -f k8s/postgres/

# 4. Deploy Ollama
kubectl apply -f k8s/ollama/

# 5. Pull Mistral model inside Ollama pod
kubectl exec -n recruitment deployment/ollama-deployment -- ollama pull mistral

# 6. Build and load app image
docker build -t recruitment-platform:latest .

# 7. Deploy app
kubectl apply -f k8s/app/

# 8. Deploy ingress
kubectl apply -f k8s/ingress/